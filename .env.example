# Copy this file to .env.local and replace every value.
# Generate CHOIR_DATA_KEY, CHOIR_TOKEN_SECRET and CRON_SECRET with:
#   npm run secrets:generate

# Neon Postgres connection string (Vercel Storage -> Neon)
DATABASE_URL=postgres://user:password@example-host.neon.tech/neondb?sslmode=require

# Private Vercel Blob store token (Vercel Storage -> Blob, private store)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# AES-256-GCM data key (base64), private-token HMAC secret and cron secret
CHOIR_DATA_KEY=replace-with-generated-value
CHOIR_TOKEN_SECRET=replace-with-generated-value
CRON_SECRET=replace-with-generated-value

# Initial administrator passcode; change it in Settings after first sign-in
CHOIR_ADMIN_PASSCODE=0331

# Optional: Resend email delivery (messages queue in the outbox without it)
# RESEND_API_KEY=re_replace_me
# CHOIR_FROM_EMAIL=choir@example.com

# Break-glass sign-in if the administrator passcode is forgotten. Leave unset
# normally. Set it (8+ characters), sign in with it, choose a new passcode in
# Settings, then delete this variable again.
# CHOIR_ADMIN_RESET_PASSCODE=
