{
  "name": "the-choir-chug",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:vercel": "next dev",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:postgres": "npm run db:generate:postgres && node --test tests/postgres-migration.test.mjs",
    "test:domain": "node --import tsx --test tests/domain.test.ts",
    "test:worker": "node --test tests/worker-api.test.mjs",
    "verify": "npm run test:domain && npm run test:postgres && npx tsc --noEmit && npm run lint && VERCEL=1 npm run build && npm run build && npm run test:worker",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:generate:postgres": "node scripts/generate-postgres-migration.mjs",
    "db:migrate:postgres": "dotenv -e .env.local -- node scripts/migrate-postgres.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "build:vercel": "VERCEL=1 bash scripts/build-verified.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/blob": "^2.8.0",
    "bidi-js": "^1.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "The Choir Chug"
}
